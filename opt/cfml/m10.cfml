<?xml version='1.0'?>
<!DOCTYPE controlset SYSTEM "cfml.dtd">
<controlset version="1.1.0" language="english" keyboard="us">
	<control function="Gas">
		<keyabsolute value="0.00" onrelease="0.00">
			<key>down arrow</key>
		</keyabsolute>
		<keyabsolute value="100.00" onrelease="0.00" index="10">
			<key>up arrow</key>
		</keyabsolute>
	</control>
</controlset>
