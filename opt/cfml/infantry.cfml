<?xml version='1.0'?>
<!DOCTYPE controlset SYSTEM "cfml.dtd">
<controlset version="1.1.0" language="english" keyboard="us">
	<control function="Mouse Look X">
		<joyaxis stick="1">trackirx</joyaxis>
	</control>
	<control function="Mouse Look Y">
		<joyaxis stick="1">trackiry</joyaxis>
	</control>
	<control function="Sprint">
		<key>left shift</key>
		<joybutton stick="3" index="1">POV1n</joybutton>
	</control>
	<control function="Crouch">
		<joybutton stick="3" index="1">1</joybutton>
	</control>
	<control function="Prone">
		<joybutton stick="3" index="1">POV1s</joybutton>
	</control>
	<control function="Forward">
		<joybutton stick="3" index="1">POV1n</joybutton>
	</control>
	<control function="Backward">
		<joybutton stick="3" index="1">POV1s</joybutton>
	</control>
	<control function="Strafe right">
		<joybutton stick="3" index="1">POV1e</joybutton>
	</control>
	<control function="Strafe left">
		<joybutton stick="3" index="1">POV1w</joybutton>
	</control>
	<control function="Reload">
		<mousebutton index="1">3</mousebutton>
	</control>
	<control function="Deploy">
		<key index="1"></key>
	</control>
	<control function="Gunsight\Alt Deploy">
		<joybutton stick="3" index="1">7</joybutton>
	</control>
	<control function="Use weapon">
		<mousebutton>1</mousebutton>
		<mousebutton index="1">1</mousebutton>
	</control>
	<control function="Select Next Weapon">
		<mousebutton index="1">wheelup</mousebutton>
	</control>
	<control function="Select Previous Weapon">
		<mousebutton index="1">wheeldown</mousebutton>
	</control>
	<control function="Vertical Aim Axis">
		<keydelta value="1.00" per="sec" index="3">
			<key></key>
		</keydelta>
	</control>
	<control function="Horizontal Aim Axis">
		<keydelta value="1.00" per="sec" index="3">
			<key></key>
		</keydelta>
	</control>
</controlset>
