<?xml version='1.0'?>
<!DOCTYPE controlset SYSTEM "cfml.dtd">
<controlset version="1.1.0" language="english" keyboard="us">
	<control function="Look Forward">
		<key></key>
	</control>
	<control function="Look Back">
		<key index="1"></key>
	</control>
	<control function="Look Up">
		<joybutton stick="1" index="1">POV1s</joybutton>
	</control>
	<control function="Look Down">
		<key index="1"></key>
	</control>
	<control function="Look Back + Right">
		<key>numpad 3</key>
	</control>
	<control function="Look Back + Left">
		<key>numpad 1</key>
	</control>
	<control function="Look Forward + Up">
		<key>numpad 8</key>
		<joybutton stick="1" index="1">POV1n</joybutton>
	</control>
	<control function="Toggle Free Look">
		<key>n</key>
		<key index="1"></key>
	</control>
	<control function="Mouse Look X">
		<keydelta value="0.00" per="sec" index="2">
			<key></key>
		</keydelta>
		<keydelta value="0.00" per="sec" index="3">
			<key></key>
		</keydelta>
		<keydelta value="-1.00" per="sec" index="4">
			<joybutton stick="1">POV1w</joybutton>
		</keydelta>
	</control>
	<control function="Mouse Look Y">
		<keydelta value="0.00" per="sec" index="2">
			<key></key>
		</keydelta>
		<keydelta value="0.00" per="sec" index="3">
			<key></key>
		</keydelta>
	</control>
	<control function="Mouse Look Z">
		<joyaxis stick="0"></joyaxis>
	</control>
</controlset>
