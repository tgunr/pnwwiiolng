"appbuild"
{
    "appid"    "251950"

    // description for this build
    "desc"    "WWIIOnLine: Client - Mac"

    // build output folder for .log, .csm & .csd files, relative to location of this file
    "buildoutput"    "../output/"

    // root content folder, relative to location of this file
    "contentroot"    "../../release-candidate/steam/WWIIOnLine/"

    // branch to set live after successful build, non if empty
    "setlive"    ""

    // to enable preview builds
    "preview"    "0"

    // set to flie path of local content server
    "local"    ""

    "depots"
    {
        "251952"    "depot_build_251952.vdf"
    }
}
