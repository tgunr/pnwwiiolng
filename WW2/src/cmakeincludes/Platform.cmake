# Determine bitness
IF (CMAKE_SIZEOF_VOID_P EQUAL 4)
	SET(CMAKE_BITNESS 32)
ELSEIF (CMAKE_SIZEOF_VOID_P EQUAL 8)
	SET(CMAKE_BITNESS 64)
ELSE ()
	MESSAGE(FATAL_ERROR "Unknown CMAKE_SIZEOF_VOID_P value ${CMAKE_SIZEOF_VOID_P}")
ENDIF ()

# Determine platform
IF (WIN32)
	SET(CMAKE_PLAT "win")
	SET_PROPERTY(GLOBAL PROPERTY USE_FOLDERS ON)
ELSEIF (APPLE)
	SET(CMAKE_PLAT "mac")
ELSEIF (UNIX)
	SET(CMAKE_PLAT "lin")
ELSE ()
	MESSAGE(FATAL_ERROR "Not a recognized platform.")
ENDIF ()

SET(CMAKE_LIBS "lib/${CMAKE_PLAT}${CMAKE_BITNESS}")

MARK_AS_ADVANCED(CMAKE_BITNESS CMAKE_PLAT CMAKE_LIBS)

MESSAGE(STATUS "Build is ${CMAKE_PLAT}${CMAKE_BITNESS}")
