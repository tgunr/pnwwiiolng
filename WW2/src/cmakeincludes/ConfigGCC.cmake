# GNU C++ Compiler configuration.

include(CheckCXXCompilerFlag)
check_cxx_compiler_flag("-std=c++14" HAVE_STD_CPP14)
IF ( HAVE_STD_CPP14 )
	SET(_LANGUAGE_FLAGS "-std=c++14")
ELSE ()
    MESSAGE(FATAL_ERROR "Compiler doesn't support -std=c++14")
ENDIF ()
SET(_LANGUAGE_FLAGS "${_LANGUAGE_FLAGS} -Winvalid-pch -Wno-array-bounds")

# SSE for everyone.
IF (IS_CLANG)
    SET(ARCHITECTURE "-mmmx -msse")
ELSE ()
    SET(ARCHITECTURE "-mmmx -msse -mfpmath=sse")
ENDIF ()
SET(USE_SSE2 1)

IF ( PN_BUILD_TYPE STREQUAL "Auth" OR PN_CLUSTER STREQUAL "Auth" )
	SET(ARCHITECTURE "-march=opteron ${ARCHITECTURE}")
ELSEIF ( PN_CLUSTER STREQUAL "Host" )
	SET(ARCHITECTURE "-march=native")
ELSEIF ( PN_CLUSTER STREQUAL "Dev" )
	SET(ARCHITECTURE "-march=native ${ARCHITECTURE}")
ELSEIF ( PN_CLUSTER STREQUAL "AMD" )
	SET(ARCHITECTURE "-march=opteron ${ARCHITECTURE} -mpopcnt -m3dnow -mabm -mcx16 -msse4a")
	SET(USE_SSE2 1)
ELSEIF ( PN_CLUSTER STREQUAL "China" )
	SET(ARCHITECTURE "-march=nocona ${ARCHITECTURE}")
	SET(USE_SSE2 1)
ELSEIF ( PN_CLUSTER STREQUAL "Live" )
	SET(ARCHITECTURE "-march=native ${ARCHITECTURE} -mcx16 -mssse3 -msse4.1")
	SET(USE_SSE2 1)
ELSE ()
	MESSAGE(ERROR "Unknown PN_CLUSTER")
ENDIF ()

IF ( USE_SSE2 )
	SET(ARCHITECTURE "${ARCHITECTURE} -msse2")
ENDIF ()

# Additional baseline compiler flags.
SET(_DIAGNOSTIC_FLAGS "-Wno-strict-aliasing -Wno-unused-result -Wno-unknown-pragmas")
IF ( PN_NICE_STACKS )
	IF ( IS_CLANG )
		SET(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fno-optimize-sibling-calls")
	ENDIF()
ENDIF ()
IF ( PN_GCC_STATS )
	IF ( NOT IS_CLANG )
		SET(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fstats")
	ENDIF ()
ENDIF ()

check_cxx_compiler_flag(-fstack-protector-all HAS_STACK_PROTECTOR)
IF ( HAS_STACK_PROTECTOR )
	OPTION( PN_STACK_PROTECT	"Enable GCC's stack protector option" OFF )
	IF ( PN_STACK_PROTECT )
		set(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fstack-protector-all")
	else ()
		set(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fno-stack-protector")
	ENDIF()
ENDIF()

IF ( PN_SANITIZER )
	set(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fsanitize=${PN_SANITIZER}")
	IF ( ${PN_ENABLE_OPTS} GREATER 1 )
		MESSAGE(FATAL_ERROR "Optimizations > 1 with sanitizers?")
	ENDIF ()
	IF ( PN_SANITIZER STREQUAL "memory" )
		set(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fsanitize-memory-track-origins=2")
	ENDIF ()
ENDIF ()

IF (NOT IS_CLANG)
	check_cxx_compiler_flag("-ftracer" HAS_FTRACER)
	IF ( HAS_FTRACER )
		OPTION( PN_TRACER			"Enable GCC's -ftracer" ON )
		IF ( PN_TRACER )
			set(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -ftracer")
		else ()
			check_cxx_compiler_flag("-fno-tracer" HAS_NO_FTRACER)
			IF ( HAS_NO_TRACER )
				set(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fno-tracer")
			ENDIF ()
		ENDIF()
	ENDIF()
ELSE ()
	SET( HAS_TRACER OFF )
	SET( PN_TRACER OFF )
ENDIF()

IF ( PN_OMIT_FRAME_POINTER )
	set(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fomit-frame-pointer")
ELSE ()
	set(_DIAGNOSTIC_FLAGS "${_DIAGNOSTIC_FLAGS} -fno-omit-frame-pointer")
ENDIF ()

IF ( PN_STATIC_ANALYZER )
	set(_DIAGNOSTIC_FLAGS "${DIAGNOSTIC_FLAGS} --analyze")
ENDIF ()

# Common -O flags.
if ( PN_ENABLE_OPTS )
	IF ( OPTIMIZATION GREATER ${PN_ENABLE_OPTS} )
		SET(OPTIMIZATION ${PN_ENABLE_OPTS})
	ENDIF ()

	IF ( OPTIMIZATION GREATER 3 )
		SET(_OPTIMIZATION_FLAG -Os )
	ELSEIF ( OPTIMIZATION GREATER 2 )
		SET(_OPTIMIZATION_FLAG -O3)
	ELSEIF ( OPTIMIZATION GREATER 1 )
		SET(_OPTIMIZATION_FLAG -O2)
	ELSE ( OPTIMIZATION GREATER 0 )
		SET(_OPTIMIZATION_FLAG -O1)
	ELSE ()
		OPTION( PN_DEBUG_OPTIMIZATION "Enable -Og" ON )
	ENDIF ()

	#IF ( OPTIMIZATION GREATER 2 )
	#	check_cxx_compiler_flag(-flto HAS_FLTO)
	#	IF ( HAS_FLTO )
	#		SET(_LINKTIME_OPTIMIZATON "-flto=9 -fwhole-program")
	#		check_cxx_compiler_flag(-fuse-linker-plugin HAS_FUSE_LINKER_PLUGIN)
	#		IF ( HAS_FUSE_LINKER_PLUGIN )
	#			SET(_LINKTIME_OPTIMIZATON "${_LINKTIME_OPTIMIZATON} -fuse-linker-plugin")
	#		ENDIF ()
	#	ENDIF ()
	#ENDIF()
ELSE ()
	SET(_OPTIMIZATION_FLAG -O0)
ENDIF()

IF ( OPTIMIZATION GREATER 2 AND PN_HEAVY_OPTS )
#	SET(_HEAVY_OPTIMIZATIONS "-fsee -fmodulo-sched -fmodulo-sched-allow-regmoves -fselective-scheduling2 -fsel-sched-pipelining -fipa-pta -fipa-matrix-reorg -ftree-loop-if-convert -ftree-loop-distribute-patterns -ftree-loop-distribution -ftree-loop-im -ftree-loop-ivcanon -fivopts -fvect-cost-model -ffunction-sections -fdata-sections -fbranch-target-load-optimize2")
ELSE ()
	SET(_HEAVY_OPTIMIZATIONS "")
ENDIF ()

IF ( PN_BUILD_32BIT )
	SET(CMAKE_CXX_FLAGS "-m32")
ELSE ()
	SET(CMAKE_CXX_FLAGS "-m64")
ENDIF ()

SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wshadow -Wno-deprecated -pthread -fno-rtti -std=c++14")
