	XML Schema Definition for Object Model Generator language.
	Author: Oliver 'kfs1' Smith <kfsone@playnet.com>
-->

<!--
 Top level "class" element, one per file.
 Requires 'name' attribute specifying class name,
 Optional 'namespace' attribute to specify a namespace.

 Must comprise one doc element followed by one or more var-group element.
-->

<!ELEMENT class (doc, (var-group|member|function)+, comment?)>
<!ATTLIST class
	namespace		CDATA		""
	name			CDATA		#REQUIRED >

<!--
 doc element provides documentation of the class.
 Requires at least a 'brief' element.
 Optional single detail element.
 Optional single returns element.
 Optional single example element.
 Optional single see-also element.
-->

<!ELEMENT doc (brief, detail?, returns?, example?, see-also*)>
<!ELEMENT brief (#PCDATA)>
<!ELEMENT detail (#PCDATA)>
<!ELEMENT returns (#PCDATA)>
<!ELEMENT example (#PCDATA)>
<!ELEMENT see-also (#PCDATA)>

<!ELEMENT comment (#PCDATA)>

<!--
 doc.var-group element, 1+ per class.
 Requires 'name' attribute specifying member name.

 Must comprise one or more element members.
-->

<!ELEMENT var-group (doc, member+, function*, comment?)>
<!ATTLIST var-group
    name			CDATA		#REQUIRED >

<!--
 var-group.member element, 1+ per var-group.
 Requires 'type' attribute which must specify a recognized variable type.
 Requires 'name' attribute (must be unique per var-group.
 Optional 'default' attribute.
 Requires 'brief' attribute which describes the element.
 Optional 'bits' attribute which allows specification of number of bits to use.
-->

<!ELEMENT member EMPTY>
<!ATTLIST member 
	type			( bool
					| UINT8 | UINT16 | UINT32 | UINT64
					| SINT8 | SINT16 | SINT32 | SINT64
					| instanceid_t
					| playerid_t
					| sortieid_t
					| TeulTimeMS | TeulDeltaMS | Teul::NetTimeMS
					| ChatHandle | PermissionMask | RANK_NO
					| FULL_OBJ_ID | WEAPON_SPEC
					| WorldPosition_m
					)	#REQUIRED
	name			CDATA		#REQUIRED
	default			CDATA		""
	brief			CDATA		#REQUIRED
	bits			CDATA		""
	>


<!--
 var-group.function element, 0+ per var-group allowed.
 Requires 'return-type' attribute specifying the function's return type.
 Requires 'name' attribute specifying the function name.
 Optional 'arguments' attribute specifying the argument list, if not void.
 Optional 'const' attribute of 'true' to enable constness.
 Requires <doc/> element.
 Optional <code/> element.
-->

<!ELEMENT function (doc, code?)>
<!ATTLIST function
	return-type		CDATA		#REQUIRED
	name			CDATA		#REQUIRED
	arguments		CDATA		""
	const			(false | true) "false"
	>

<!ELEMENT code	(#PCDATA)>

