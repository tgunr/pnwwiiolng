DEBUG;
NAMESPACE MM;

TYPE Teul::NetTimeMS;
TYPE FULL_OBJ_ID;
TYPE WEAPON_SPEC;
TYPE RANK_NO;
TYPE ChatHandle;

MESSAGE SortieData
{
	// Describes an ongoing or completed sortie.

	GROUP Sortie
	{
		UINT32			sortieID;
		Teul::NetTimeMS spawned_ms;
		Teul::NetTimeMS despawned_ms;
		FULL_OBJ_ID		originFac;
		FULL_OBJ_ID		target;
		UINT32			flags;
	};
  
	GROUP Vehicle
	{
		WEAPON_SPEC		weaponSpec;
		RANK_NO			effectiveRank;
		UINT8			rtbState;
		UINT8			decal; // of the player leading the sortie
		ChatHandle		killedBy;
		FULL_OBJ_ID		rtbFacility;
	};
  
	GROUP Location
	{
		SINT32			x;
		SINT32			y;
		SINT32			z;
		UINT32			riding;
		FULL_OBJ_ID		nearCP;
	};

	GROUP Scoring
	{
		UINT32			hits;
		UINT16			kills;
		UINT16			captures;
		UINT16			defends;
		UINT16			aiKills;
		UINT16			aiRepairs;
		UINT16			bridgeKills;
		UINT16			bridgeRepairs;

		UINT16			factoryKills;
		UINT16			firebaseKills;
		UINT16			resupplies;
		UINT16			resuppliesScored;
		UINT16			guardingKills;
		UINT16			cappingKills;
		UINT16			umsKills;
		UINT16			guardingPoints;

		UINT32			spawnees;
		UINT16			uniqueHits;
		UINT16			vehtypesHit;
		UINT16			points;
		UINT16			assists;
	};
  
//  GROUP Reservation
//  {
//      bool isReserved;
//      FULL_OBJ_ID facility;
//  };

	{{
		UINT32 sortieID() const { return sortie().sortieID(); }
		TeulTimeMS duration_ms() const { return sortie().despawned_ms() - sortie().spawned_ms(); }
		UINT32 duration_s() const { return UINT32(duration_ms() / 1000U); }
	}}
};

