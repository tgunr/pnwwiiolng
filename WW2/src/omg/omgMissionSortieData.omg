NAMESPACE MM;
CLIENT FRONTEND;		// These are messages delivered between WW2 client <-> Game Servers

USING "typedefs.omg";

// By default messages are assumed to be client->host, unidirectional.
// If that's not true, you have to override the behavior with one or both of
//  TOCLIENT TOHOST
MESSAGE SortieData [ TOCLIENT ]
{
	// Describes an ongoing or completed sortie.

	GROUP Sortie
	{
		UINT32			sortieID;
		NetTimeMS		spawned_ms;
		NetTimeMS		despawned_ms;
		FULL_OBJ_ID		originFac;
		FULL_OBJ_ID		target;
		UINT32			flags;
	};
  
	GROUP Vehicle
	{
		WEAPON_SPEC		weaponSpec;
		RANK_NO			effectiveRank;
		UINT8			rtbState;
		UINT8			decal; // of the player leading the sortie
		ChatHandle		killedBy;
		FULL_OBJ_ID		rtbFacility;
	};
  
	GROUP Location
	{
		SINT32			x;
		SINT32			y;
		SINT32			z;
		UINT32			riding;
		FULL_OBJ_ID		nearCP;
	};

	GROUP Scoring
	{
		UINT32			hits;
		UINT16			kills;
		UINT16			captures;
		UINT16			defends;
		UINT16			aiKills;
		UINT16			aiRepairs;
		UINT16			bridgeKills;
		UINT16			bridgeRepairs;

		UINT16			factoryKills;
		UINT16			firebaseKills;
		UINT16			resupplies;
		UINT16			resuppliesScored;
		UINT16			guardingKills;
		UINT16			cappingKills;
		UINT16			umsKills;
		UINT16			guardingPoints;

		UINT32			spawnees;
		UINT16			uniqueHits;
		UINT16			vehtypesHit;
		UINT16			points;
		UINT16			assists;
	};
  
//  GROUP Reservation
//  {
//      bool isReserved;
//      FULL_OBJ_ID facility;
//  };

	{{
		UINT32 sortieID() const { return sortie().sortieID(); }
		TeulTimeMS duration_ms() const { return sortie().despawned_ms() - sortie().spawned_ms(); }
		UINT32 duration_s() const { return UINT32(duration_ms() / 1000U); }
	}}
};

// MESSAGE TestCond [ TOSERVER ], default behavior so equivalent to:
MESSAGE TestCond
{
	UINT32				sortieID;
	UINT32				pilotID;
	ChatHandle			pilotName;
	UINT32				crewID;
	IF (crewID != 0) {
		// only pack the crewHandle if we are sending a non-zero crewID.
		ChatHandle		crewHandle;
		IF (crewHandle != 0) {
			UINT8		crewDecal;
		}
		ARRAY Component[64] {
			UINT8		id;
			UINT8		damage;
			IF (damage > 0) {
				ARRAY Id[8] {
					UINT8	idNo;
					IF (idNo) {
						UINT8	damage[4];
					}
				}
			}
		}
	}
	UINT32				array[32];
	UINT32				bitty bits=24;
};
