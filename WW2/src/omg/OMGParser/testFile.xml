<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE class SYSTEM "omg.dtd">

<!--
Test case object for OMG parser.
Output:
omgTestFile.h
omgTestFile.cpp
-->

<class namespace="OMG" name="Test">
  <doc>
    <brief>Short description of object.</brief>
    <detail>
      Longer explanation of object.
    </detail>
  </doc>

  <comment> Comment in the xml, not passed to the source files. </comment>

  <member type="UINT32" name="testID" brief="Unique ID for the particular test." />
  <member type="TeulTimeMS" name="createdAt" brief="TimeStamp of our creation." />

  <function return-type="TeulTimeMS" name="timeSinceCreation" const="true" inline="true">
    <doc>
      <brief> Calculate the miliseconds since the object was created. </brief>
      <returns> 0 to indicate "now", otherwise a positive number of miliseconds since creation.</returns>
    </doc>
    <code>
      TeulTimeMS delta = (teulClock64 > timeSinceCreation) ? 0ULL : teulClock64 - timeSinceCreation;
      return delta;
    </code>
  </function>

  <sub-struct name="MyStruct">
    <doc>
      <brief>Just a sub-structure within OMG::Test.</brief>
      <detail>
        Should be accessible as OMG::Test::MyStruct.
      </detail>
    </doc>

    <member type="UINT16" name="testValue" brief="Just a 16-bit test value." />

    <function return-type="UINT16" name="getTestValue" const="true" inline="false">
      <doc>
        <brief>Get the value of testValue.</brief>
        <returns>The value of testValue.</returns>
      </doc>
      <code>
        return testValue;
      </code>
    </function>

    <member type="UINT32" name="testArray" brief="A std::vector-based array.">
      <vector capacity="50"/>
    </member>
  </sub-struct>

  <sub-class name="MyClass">
    <doc>
      <brief>A test sub-class.</brief>
      <detail>
        Should be accessible as OMG::Test::MyClass.
      </detail>
    </doc>

    <member type="bool" name="testInlineArray" brief="A WWII::inplace_vector array.">
      <vector inline="true" capacity="42"/>
    </member>

    <function return-type="UINT32" name="getArraySize" const="true" inline="true">
      <doc>
        <brief>Gets the current size of the inline array.</brief>
        <returns>0 if empty, otherwise a positive count of the number of testInlineArray elements.</returns>
      </doc>
      <code> return ( testInlineArray.empty() ? 0 : testInlineArray.size() ) ; </code>
    </function>
  </sub-class>
</class>
