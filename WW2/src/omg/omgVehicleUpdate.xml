<?xml version='1.0'?>
<!DOCTYPE class SYSTEM "omg.dtd">

<class
	namespace='Vehicle'
	name='Update'>

	<doc>
		<brief>Host/Client interface classes for describing player vehicles.</brief>

		<detail>
			Various components required to describe the position, type and movement
			of a player vehicle.
		</detail>
	</doc>

	<member type='UINT32' name='hostIndex' brief="Host's index for this vehicle."/>

	<var-group name='Data'>
		<doc> <brief> Flags or flag-like values that may change fairly often. </brief> </doc>

		<member type='UINT16'		name='oneTimeBits'	brief="Vehicle's OneTimeBits."/>
		<member type='UINT32'		name='clientFlags1'	brief="Client's vis bits."/>
		<member type='UINT32'		name='clientFlags2'	brief="Client's animation bits."/>
		<member type='UINT8'		name='fireMask'		brief="Turret firing mask."/>
		<member type='UINT32'		name='ridingVeh'	brief="Host index of vehicle being ridden."/>
		<member type='UINT8'		name='ridingSeat'	brief="Client's index for seat."/>

		<comment> ** Room for 2 more. </comment>
	</var-group>

	<var-group name='Model'>
		<doc> <brief> Position, orientation and speed of the vehicle. </brief> </doc>

		<member type='SINT32'		name='posX'			brief='X position.'/>
		<member type='SINT32'		name='posY'			brief='Y position.'/>
		<member type='SINT32'		name='posZ'			brief='Z position.'/>

		<member type='SINT32'		name='attX'			brief='X attitude.'/>
		<member type='SINT32'		name='attY'			brief='Y attitude.'/>
		<member type='SINT32'		name='attZ'			brief='Z attitude.'/>

		<member type='SINT32'		name='velX'			brief='X velocity.'/>
		<member type='SINT32'		name='velY'			brief='Y velocity.'/>
		<member type='SINT32'		name='velZ'			brief='Z velocity.'/>

		<member type='SINT32'		name='accX'			brief='X acceleration.'/>
		<member type='SINT32'		name='accY'			brief='Y acceleration.'/>
		<member type='SINT32'		name='accZ'			brief='Z acceleration.'/>

		<member type='SINT32'		name='rotX'			brief='Rotational X (formerly attvel).'/>
		<member type='SINT32'		name='rotY'			brief='Rotational Y (formerly attvel).'/>
		<member type='SINT32'		name='rotZ'			brief='Rotational Z (formerly attvel).'/>

		<comment> ** Room for 1 more. </comment>
	</var-group>

	<comment>
	** Missing:
		- Riding relative position (x, y, z, yaw)
		- Turret data.
	</comment>

</class>

