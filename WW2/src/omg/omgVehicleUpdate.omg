NAMESPACE Vehicle;

MESSAGE Update
{
	// Host/client interface for describing vehicles
  
	UINT32	hostIndex;
  
	GROUP Data
	{
		UINT16	oneTimeBits;
		UINT32	clientFlags1;	// Client's vis bits
		UINT32	clientFlags2;	// Client's animation bits
		UINT8	fireMask;
		UINT32	ridingVeh;
		UINT32	ridingSeat;
	}
  
	GROUP Model
	{
		SINT32	posX, posY, posZ;
		SINT32	attX, attY, attZ;
		SINT32	velX, velY, velZ;
		SINT32	accX, accY, accZ;
		SINT32	rotX, rotY, rotZ;
	}

//	** Missing:
//		- Riding relative position (x, y, z, yaw)
//		- Turret data.
}
