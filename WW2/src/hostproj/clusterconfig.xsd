<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2013 sp1 (x64) (http://www.altova.com) by Oliver (KFS) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.kfs.org/XML/WWIIOL" targetNamespace="http://www.kfs.org/XML/WWIIOL" elementFormDefault="qualified">
	<xs:simpleType name="t_IPv4ClassCAddress">
		<xs:annotation>
			<xs:documentation>
        IPv4 Class C address in the dotted-decimal notation.
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){2}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_IPv4Address">
		<xs:annotation>
			<xs:documentation>
        IPv4 address in the dotted-decimal notation.
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_Port">
		<xs:annotation>
			<xs:documentation>
        Port number in the range [1, 65536].
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:unsignedShort">
			<xs:minInclusive value="1"/>
		</xs:restriction>
	</xs:simpleType>
  <xs:complexType name="t_Server">
    <xs:annotation>
      <xs:documentation>
        Describes a server in terms of IP address and port.
      </xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="Address" type="t_IPv4Address"/>
      <xs:element name="Port" type="t_Port" minOccurs="0"/>
    </xs:all>
  </xs:complexType>
	<xs:complexType name="t_ServerWithIdentity">
		<xs:annotation>
			<xs:documentation>
        Describes how to reach and authenticate to a particular server.
      </xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="Address" type="t_IPv4Address"/>
			<xs:element name="Port" type="t_Port" minOccurs="0"/>
			<xs:element name="User" type="xs:string"/>
			<xs:element name="Password" type="xs:string"/>
		</xs:all>
	</xs:complexType>
	<xs:simpleType name="t_WindowsDrive">
		<xs:annotation>
			<xs:documentation>
        Specify a drive name (Windows only).
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z]:"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="ClusterConfig">
		<xs:annotation>
			<xs:documentation>
        Configuration spec for a WWIIOL Game Cluster.
      </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="General">
					<xs:annotation>
						<xs:documentation>
              General properties that don't fit anywhere else.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element name="Name" type="xs:string">
								<xs:annotation>
									<xs:documentation>
                    Give this cluster a name.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="MaxPlayers" type="xs:unsignedShort" default="3000">
								<xs:annotation>
									<xs:documentation>
                    Maximum total number of players supported by this cluster.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="MaxQueuedPlayers" type="xs:unsignedShort" default="0" minOccurs="0">
								<xs:annotation>
									<xs:documentation>
                    Maximum players to allow in the queue before we stop queueing. Set to 0 for no limit.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="BasePath" type="xs:string">
								<xs:annotation>
									<xs:documentation>
                    Top-level directory for all game files/paths.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="BaseDrive" type="t_WindowsDrive" minOccurs="0" maxOccurs="1"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="Network">
					<xs:annotation>
						<xs:documentation>
              Cluster-wide network configuration parameters.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
              <xs:element name="ServerNet" type="t_IPv4ClassCAddress">
                <xs:annotation>
                  <xs:documentation>
                    Specify which Class C to use for (protected) server-to-server communications.
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="CellNet" type="t_IPv4ClassCAddress" default="127.0.11" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>
                    Specify which Class C to use for (protected) cell-to-cell communications without colliding with other server-to-server messages.
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="Database">
					<xs:annotation>
						<xs:documentation>
              Configuration for databases and database access.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element name="MySQL">
								<xs:annotation>
									<xs:documentation>
                    MySQL specific options.
                  </xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:all>
                    <xs:element name="EnableCompression" type="xs:boolean" default="false" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Enable MySQL binary compression - enabling this costs CPU but saves network bandwidth.
                        </xs:documentation>
                      </xs:annotation>
                    </xs:element>
									</xs:all>
								</xs:complexType>
							</xs:element>
							<xs:element name="Game" type="t_ServerWithIdentity">
								<xs:annotation>
									<xs:documentation>
                    Address and credentials for accessing the Game Database.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Auth" type="t_ServerWithIdentity">
								<xs:annotation>
									<xs:documentation>
                    Address and credentials for accessing the Authentication Database.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="Auth">
					<xs:annotation>
						<xs:documentation>
              Auth-related configuration for the cluster.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
              <xs:element name="ErrorURL" type="xs:anyURI">
                <xs:annotation>
                  <xs:documentation>
                    URL prefix for authentication errors, e.g. http://www.gamesite.com/auth/errors/autherr.html. Error information is added as query parameters.
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
							<xs:element name="AppID" type="xs:unsignedByte"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="ClusterBoss">
					<xs:annotation>
						<xs:documentation>
              Configure the master process for the cluster.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
              <xs:element name="Master" type="t_Server">
                <xs:annotation>
                  <xs:documentation>
                    Specifies which system will be the master cluster boss.
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Plans">
                <xs:annotation>
                  <xs:documentation>
                    Describe one or more cluster layouts.
                  </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Plan" minOccurs="1" maxOccurs="unbounded">
                      <xs:annotation>
                        <xs:documentation>
                          Describes how processes should be distributed across servers.
                        </xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Host" minOccurs="1" maxOccurs="unbounded">
                            <xs:annotation>
                              <xs:documentation>
                                Describes a discrete host machine.
                              </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:all>
                                <xs:element name="Require" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation>
                                      Specify one or more requirements to meet the specs of this host.
                                    </xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:choice>
                                      <xs:element name="Network" type="t_IPv4ClassCAddress"/>
                                    </xs:choice>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="Strat" minOccurs="0" maxOccurs="1"/>
                                <xs:element name="DBD" minOccurs="0" maxOccurs="1"/>
                                <xs:element name="Chat" minOccurs="0" maxOccurs="1"/>
                                <xs:element name="Map" minOccurs="0" maxOccurs="1"/>
                                <xs:element name="Ping" minOccurs="0" maxOccurs="1"/>
                                <xs:element name="Cell" minOccurs="0" maxOccurs="1"/>
                              </xs:all>
                              <xs:attribute name="Priority" type="xs:unsignedByte" use="required"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="Name" type="xs:string"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="StratHost">
					<xs:annotation>
						<xs:documentation>
              Strat-host specific configuration.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element name="Lua">
								<xs:annotation>
									<xs:documentation>
                    Lua environment configuration for strat.
                  </xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:all>
										<xs:element name="Path" type="xs:string" default="/playnet/wwiiol/lua">
											<xs:annotation>
												<xs:documentation>
                          Where to source Lua scripts.
                        </xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="RCFile" type="xs:string" default="rc.lua">
											<xs:annotation>
												<xs:documentation>
                          Lua startup file.
                        </xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:all>
								</xs:complexType>
							</xs:element>
							<xs:element name="Language">
                <xs:annotation>
                  <xs:documentation>
                    Specify which language to use for strat translations: 'en' or 'zh'.
                  </xs:documentation>
                </xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="en"/>
										<xs:enumeration value="zh"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="IgnoreErrors" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>
                    Set true to ignore/not-output language errors during strat loading.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="ChatHost">
					<xs:annotation>
						<xs:documentation>
              Chat-host specific configuration.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element name="MaxPlayersPer" type="xs:unsignedShort" default="8000" minOccurs="0">
								<xs:annotation>
									<xs:documentation>
                    Maximum players a single chat host can support.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="MapHost">
					<xs:annotation>
						<xs:documentation>
              Map-host specific configuration.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element name="MaxPlayersPer" type="xs:unsignedShort" default="4000" minOccurs="0">
								<xs:annotation>
									<xs:documentation>
                    Maximum players a single map host can support.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="CellHost">
					<xs:annotation>
						<xs:documentation>
              Cell-host specific configuration.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element name="MaxPlayersPer" type="xs:unsignedShort" default="1500" minOccurs="0">
								<xs:annotation>
									<xs:documentation>
                    Maximum players each cell host can support.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="IRC">
					<xs:annotation>
						<xs:documentation>
              IRC configuration.
            </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element name="Enabled" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>
                    Enabled="true" will tell server processes to connect to a central IRC server for monitoring and interactive configuration.
                  </xs:documentation>
								</xs:annotation>
							</xs:element>
              <xs:element name="Server" type="t_ServerWithIdentity" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>
                    Specifies the address and login credentials for the IRC server (optional).
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
			</xs:all>
			<xs:attribute name="version" type="xs:decimal"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
