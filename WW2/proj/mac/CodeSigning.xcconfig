// It is expected that this file may have local modifications that are never
// committed. The version existing in version control sets a default signing
// identity. In the future it may also contain settings pertaining to excluding
// or including the archives in code signing.

// Code sign identity - what kind of code signing?
CODE_SIGN_IDENTITY_Development =
CODE_SIGN_IDENTITY_Release = Developer ID Application

CODE_SIGN_IDENTITY_MC = $(CODE_SIGN_IDENTITY_Development)
CODE_SIGN_IDENTITY_Debug = $(CODE_SIGN_IDENTITY_Development)
CODE_SIGN_IDENTITY_BetaRelease = $(CODE_SIGN_IDENTITY_Development)
CODE_SIGN_IDENTITY_GM = $(CODE_SIGN_IDENTITY_Release)

CODE_SIGN_IDENTITY = $(CODE_SIGN_IDENTITY_$(CONFIGURATION))

// Development team identifier (same for all configs)
DEVELOPMENT_TEAM = 755QPC3L4G

// Provisioning profile
PROVISIONING_PROFILE_SPECIFIER_Development =
PROVISIONING_PROFILE_SPECIFIER_Release = WWIIOL Developer ID Distribution Profile

PROVISIONING_PROFILE_SPECIFIER_MC = $(PROVISIONING_PROFILE_SPECIFIER_Development)
PROVISIONING_PROFILE_SPECIFIER_Debug = $(PROVISIONING_PROFILE_SPECIFIER_Development)
PROVISIONING_PROFILE_SPECIFIER_BetaRelease = $(PROVISIONING_PROFILE_SPECIFIER_Development)
PROVISIONING_PROFILE_SPECIFIER_GM = $(PROVISIONING_PROFILE_SPECIFIER_Release)

PROVISIONING_PROFILE_SPECIFIER = $(PROVISIONING_PROFILE_SPECIFIER_$(CONFIGURATION))
