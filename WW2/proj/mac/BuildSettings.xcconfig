// Get all our warning flags
#include "Warnings.xcconfig"

// Get all our preprocessor macros
#include "Defines.xcconfig"

// Grab code signing configuration
#include "CodeSigning.xcconfig"

// Grab various search paths
#include "SearchPaths.xcconfig"

// Basic architecture settings common to everything
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 10.9
SDKROOT = macosx
ARCHS = $(ARCHS_STANDARD_32_BIT)
VALID_ARCHS = i386
// IMPORTANT: This MUST be turned off until the Mac client can be made 64-bit.
// Xcode will fail to build otherwise, since all Macs are 64-bit and therefore
// the "active" arch will always be one that's not in ARCHS.
ONLY_ACTIVE_ARCH = NO

// Build output paths
SYMROOT = proj/mac/build
OBJROOT = proj/mac/build


// Settings common to all configurations
DEPLOYMENT_POSTPROCESSING = YES                             // Do run the strip and permission-fixing build steps
SKIP_INSTALL = YES                                          // Don't try to install any of these files anywhere (makes archiving work)
GCC_INLINES_ARE_PRIVATE_EXTERN = YES                        // Don't export inline functions
GCC_SYMBOLS_PRIVATE_EXTERN = YES                            // Don't export anything else either
GCC_C_LANGUAGE_STANDARD = gnu11                             // Use C11 with GNU extensions for C files
CLANG_CXX_LANGUAGE_STANDARD = gnu++14                       // Use C++14 with GNU extensions for C++ files
CLANG_CXX_LIBRARY = libc++                                  // Use Clang's libc++
GCC_GENERATE_DEBUGGING_SYMBOLS = YES                        // Always generate debugging symbols
DEPLOYMENT_POSTPROCESSING = YES                             // Strip and set proper file modes on binaries
STRIP_STYLE = non-global                                    // Always strip all non-global symbols if stripping is enabled
GCC_ENABLE_TRIGRAPHS = NO                                   // Don't allow C89 trigraphs, ew
GCC_ENABLE_PASCAL_STRINGS = NO                              // Don't allow \p for Pascal strings, why would you want this?
RUN_CLANG_STATIC_ANALYZER = NO                              // Don't run the static analyzer if not explicitly requested
CLANG_STATIC_ANALYZER_MODE_ON_ANALYZE_ACTION = deep         // Do deep analysis when explicitly requested
CLANG_STATIC_ANALYZER_MODE = shallow                        // Do shallow analysis the rest of the time
ENABLE_NS_ASSERTIONS = YES                                  // Enable assertions from Objective-C code
ENABLE_STRICT_OBJC_MSGSEND = YES                            // Enforce good typing in use of objc_msgSend()
OTHER_LDFLAGS = -bind_at_load                               // Just skip over any Objective-C linking issues
CLANG_ENABLE_OBJC_ARC = YES                                 // Enable ARC, now that Clang in Xcode 8 supports it for 32-bit
CLANG_ADDRESS_SANITIZER_CONTAINER_OVERFLOW = YES            // More C++ ASAN checks

// Settings for Development configuration - please keep this in sync with Debug
GCC_UNROLL_LOOPS_Development            = NO                // Don't unroll loops
GCC_OPTIMIZATION_LEVEL_Development      = 0                 // Don't optimize anything at all
DEBUG_INFORMATION_FORMAT_Development    = dwarf             // Don't use a separate dSYM file
STRIP_INSTALLED_PRODUCT_Development     = NO                // Don't strip the built binary

// Settings for Debug configuration - please keep this in sync with Development
GCC_UNROLL_LOOPS_Debug                  = NO                // Don't unroll loops
GCC_OPTIMIZATION_LEVEL_Debug            = 0                 // Don't optimize anything at all
DEBUG_INFORMATION_FORMAT_Debug          = dwarf             // Don't use a separate dSYM file
STRIP_INSTALLED_PRODUCT_Debug           = NO                // Don't strip the built binary

// Settings for Release configuration - there's nothing to sync this with :)
GCC_UNROLL_LOOPS_Release                = YES               // Do unroll loops
GCC_OPTIMIZATION_LEVEL_Release          = fast              // Optimize for size and speed
DEBUG_INFORMATION_FORMAT_Release        = dwarf-with-dsym   // Keep debugging information separate
STRIP_INSTALLED_PRODUCT_Release         = YES               // Do strip the built binary

// Settings for BetaRelease configuration - there's nothing to sync this with :)
GCC_UNROLL_LOOPS_BetaRelease                = YES               // Do unroll loops
GCC_OPTIMIZATION_LEVEL_BetaRelease          = fast              // Optimize for size and speed
DEBUG_INFORMATION_FORMAT_BetaRelease        = dwarf-with-dsym   // Keep debugging information separate
STRIP_INSTALLED_PRODUCT_BetaRelease         = YES               // Do strip the built binary

// Settings for MC configuration - there's nothing to sync this with :)
GCC_UNROLL_LOOPS_MC                     = NO                // Do unroll loops
GCC_OPTIMIZATION_LEVEL_MC               = 0                 // Optimize for size and speed
DEBUG_INFORMATION_FORMAT_MC             = dwarf             // Keep debugging information separate
STRIP_INSTALLED_PRODUCT_MC              = NO                // Do strip the built binary

// Settings for GM configuration - always identical to release but have to be specified explicitly due to Xcode limitations
GCC_UNROLL_LOOPS_GM                     = $(GCC_UNROLL_LOOPS_Release)
GCC_OPTIMIZATION_LEVEL_GM               = $(GCC_OPTIMIZATION_LEVEL_Release)
DEBUG_INFORMATION_FORMAT_GM             = $(DEBUG_INFORMATION_FORMAT_Release)
STRIP_INSTALLED_PRODUCT_GM              = $(STRIP_INSTALLED_PRODUCT_Release)

// Gather the config-specific settings
GCC_UNROLL_LOOPS = $(GCC_UNROLL_LOOPS_$(CONFIGURATION))
GCC_OPTIMIZATION_LEVEL = $(GCC_OPTIMIZATION_LEVEL_$(CONFIGURATION))
DEBUG_INFORMATION_FORMAT = $(DEBUG_INFORMATION_FORMAT_$(CONFIGURATION))
STRIP_INSTALLED_PRODUCT = $(STRIP_INSTALLED_PRODUCT_$(CONFIGURATION))
