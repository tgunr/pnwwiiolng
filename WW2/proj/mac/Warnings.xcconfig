////////////////////////////////////////////////////////////////////////////////
// Warnings. This setup enables ALL the warnings Clang's ever heard of,
// including a lot of really useless ones, then shuts off those plus the ones we
// can't deal with or don't consider issues. It's a shame the xcconfig parser is
// so weak; even a Makefile could do a += and not require the -W prefixes. Or,
// for that matter, have a \ to escape a newline!
//
// Please note, it is NOT practical to generate the xcconfig files from some
// more interesting source language, Xcode doesn't handle it very well when an
// xcconfig changes after a user action.
//
// The _00 one is just space filler for visual consistency. It's empty.
//
// See the comments in Defines.xcconfig for a bit more info.

WW2_WARNINGS_34 = $(WW2_WARNINGS_35) -Wno-double-promotion                      // Honestly, I just don't care.
WW2_WARNINGS_33 = $(WW2_WARNINGS_34) -Wno-cstring-format-directive              // It's okay to use %s with NSString, Apple
WW2_WARNINGS_32 = $(WW2_WARNINGS_33) -Wno-error=c++11-narrowing                 // Don't make this a hard error, even though it should be
WW2_WARNINGS_31 = $(WW2_WARNINGS_32) -Wno-packed                                // Yay, we're packing when we don't need to, big whoop
WW2_WARNINGS_30 = $(WW2_WARNINGS_31) -Wno-pedantic                              // Don't be pedantic
WW2_WARNINGS_29 = $(WW2_WARNINGS_30) -Wno-gnu-anonymous-struct                  // Yet another GNU extension we actually like
WW2_WARNINGS_28 = $(WW2_WARNINGS_29) -Wno-cast-align                            // Alignment is not one of our current issues
WW2_WARNINGS_27 = $(WW2_WARNINGS_28) -Wno-covered-switch-default                // Covered defaults are safety nets
WW2_WARNINGS_26 = $(WW2_WARNINGS_27) -Wno-exit-time-destructors                 // Global destructors are pretty obvious too
WW2_WARNINGS_25 = $(WW2_WARNINGS_26) -Wno-documentation                         // We don't want documentation validation
WW2_WARNINGS_24 = $(WW2_WARNINGS_25) -Wno-unused-parameter                      // Unused parameters is not a useful warning, it happens too often
WW2_WARNINGS_23 = $(WW2_WARNINGS_24) -Wno-c++98-compat                          // We don't care if we're compatible with C++98 anymore
WW2_WARNINGS_22 = $(WW2_WARNINGS_23) -Wno-padded                                // Struct padding isn't useful info most of the time
WW2_WARNINGS_21 = $(WW2_WARNINGS_22) -Wno-undef                                 // Use of undefined macros is common on most platforms
WW2_WARNINGS_20 = $(WW2_WARNINGS_21) -Wno-c++98-compat-pedantic                 // C++98 is dead, long live C++14
WW2_WARNINGS_19 = $(WW2_WARNINGS_20) -Wno-used-but-marked-unused                // This happens a lot with debug functions
WW2_WARNINGS_18 = $(WW2_WARNINGS_19) -Wno-c99-extensions                        // We don't care about C89 either!
WW2_WARNINGS_17 = $(WW2_WARNINGS_18) -Wno-disabled-macro-expansion              // This is a normal behavior of the preprocessor, who cares
WW2_WARNINGS_16 = $(WW2_WARNINGS_17) -Wno-unused-macros                         // Unused macros are common
WW2_WARNINGS_15 = $(WW2_WARNINGS_16) -Wno-unused-exception-parameter            // Unused exception parameters are stupid but do happen
WW2_WARNINGS_14 = $(WW2_WARNINGS_15) -Wno-global-constructors                   // Global constructors are pretty obvious
WW2_WARNINGS_13 = $(WW2_WARNINGS_14) -Wno-switch-enum                           // Unhandled switch cases are too noisy in this codebase
WW2_WARNINGS_12 = $(WW2_WARNINGS_13) -Wno-gnu-zero-variadic-macro-arguments     // We like this GNU extension, why warn?
WW2_WARNINGS_11 = $(WW2_WARNINGS_12) -Wno-variadic-macros                       // This one too
WW2_WARNINGS_10 = $(WW2_WARNINGS_11) -Wno-missing-noreturn                      // This could be removed after a code audit
WW2_WARNINGS_09 = $(WW2_WARNINGS_10) -Wno-unknown-warning-option                // No worrying about different compiler versions whining
WW2_WARNINGS_08 = $(WW2_WARNINGS_09) -Wno-auto-import                           // This is a desired behavior
WW2_WARNINGS_07 = $(WW2_WARNINGS_08) -Wno-overlength-strings                    // Unfortunately, this happens often in real code
WW2_WARNINGS_06 = $(WW2_WARNINGS_07) -Wno-assign-enum                           // Way too noisy in this codebase
WW2_WARNINGS_05 = $(WW2_WARNINGS_06) -Wno-objc-missing-property-synthesis       // This is desired in autosynthesizing contexts
WW2_WARNINGS_04 = $(WW2_WARNINGS_05) -Wno-gnu-conditional-omitted-operand       // We like this GNU extension too
WW2_WARNINGS_03 = $(WW2_WARNINGS_04) -Wno-old-style-cast                        // Too noisy in this codebase
WW2_WARNINGS_02 = $(WW2_WARNINGS_03) -Wno-documentation-unknown-command         // WAAAAAAY too noisy in this codebase and also not very useful anyway
WW2_WARNINGS_01 = $(WW2_WARNINGS_02) -Wno-reserved-id-macro                     // We use lots of _-prefixed macros

WW2_WARNINGS    = -Weverything       $(WW2_WARNINGS_01)                         // Turn on EEEEEEEVERYTHING by default

WW2_ENABLE_NONFLAG_WARNINGS_Development     = YES
WW2_ENABLE_NONFLAG_WARNINGS_Debug           = YES
WW2_ENABLE_NONFLAG_WARNINGS_Release         = NO
WW2_ENABLE_NONFLAG_WARNINGS_GM              = NO

WW2_ENABLE_NONFLAG_WARNINGS                 = $(WW2_ENABLE_NONFLAG_WARNINGS_$(CONFIGURATION))

// These are all partially (but not completely?) independent of WARNING_CFLAGS
// and need to be specified explicitly, thanks to Xcode adding its own -W and
// -Wno flags *after* WARNING_CFLAGS sometimes. Sigh. Note that we
// unconditionally enable a few of these that should really be on even in pure
// release builds.
GCC_WARN_ABOUT_MISSING_FIELD_INITIALIZERS = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_ABOUT_MISSING_PROTOTYPES = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_ABOUT_RETURN_TYPE = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_NON_VIRTUAL_DESTRUCTOR = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_HIDDEN_VIRTUAL_FUNCTIONS = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN__EXIT_TIME_DESTRUCTORS = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_INITIALIZER_NOT_FULLY_BRACKETED = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_MISSING_PARENTHESES = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_CHECK_SWITCH_STATEMENTS = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_UNUSED_FUNCTION = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_UNUSED_LABEL = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_UNUSED_PARAMETER = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_UNUSED_VARIABLE = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_UNUSED_VALUE = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_EMPTY_BODY = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE // Critical
GCC_WARN_UNKNOWN_PRAGMAS = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_SHADOW = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_FOUR_CHARACTER_CONSTANTS = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_CONSTANT_CONVERSION = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_INT_CONVERSION = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_64_TO_32_BIT_CONVERSION = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_ENUM_CONVERSION = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_BOOL_CONVERSION = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_SUSPICIOUS_IMPLICIT_CONVERSION = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_ABOUT_MISSING_NEWLINE = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_IMPLICIT_SIGN_CONVERSION = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_NULLABLE_TO_NONNULL_CONVERSION = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_CXX0X_EXTENSIONS = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_OBJC_EXPLICIT_OWNERSHIP_TYPE = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_OBJC_REPEATED_USE_OF_WEAK = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_UNREACHABLE_CODE = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN__ARC_BRIDGE_CAST_NONARC = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_STRICT_SELECTOR_MATCH = NO // Not helpful
GCC_WARN_UNDECLARED_SELECTOR = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_OBJC_ROOT_CLASS = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
CLANG_WARN__DUPLICATE_METHOD_MATCH = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_OBJC_IMPLICIT_ATOMIC_PROPERTIES = NO // Not helpful
CLANG_WARN_OBJC_MISSING_PROPERTY_SYNTHESIS = NO // Not helpful
GCC_WARN_ALLOW_INCOMPLETE_PROTOCOL = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_ABOUT_INVALID_OFFSETOF_MACRO = YES // Critical
GCC_TREAT_INCOMPATIBLE_POINTER_TYPE_WARNINGS_AS_ERRORS = NO // No errors please
GCC_TREAT_IMPLICIT_FUNCTION_DECLARATIONS_AS_ERRORS = NO // No errors please
GCC_WARN_TYPECHECK_CALLS_TO_PRINTF = YES // Critical
CLANG_WARN_ASSIGN_ENUM = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_ABOUT_POINTER_SIGNEDNESS = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_SIGN_COMPARE = $(WW2_ENABLE_NONFLAG_WARNINGS)
GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS = $(WW2_ENABLE_NONFLAG_WARNINGS)
CLANG_WARN_DOCUMENTATION_COMMENTS = NO // Not helpful
CLANG_WARN_INFINITE_RECURSION = YES // Critical (logic error)
CLANG_WARN_SUSPICIOUS_MOVE = YES // Critical (performance, correctness)

// Enable extra analyze modes
CLANG_ANALYZER_SECURITY_FLOATLOOPCOUNTER = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_RAND = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_STRCPY = YES
CLANG_ANALYZER_DEADCODE_DEADSTORES = YES
CLANG_ANALYZER_MEMORY_MANAGEMENT = YES
CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED = YES
CLANG_ANALYZER_LOCALIZABILITY_EMPTY_CONTEXT = YES
CLANG_ANALYZER_NONNULL = YES
CLANG_ANALYZER_GCD = YES
CLANG_ANALYZER_OBJC_ATSYNC = YES
CLANG_ANALYZER_OBJC_DEALLOC = YES
CLANG_ANALYZER_OBJC_NSCFERROR = YES
CLANG_ANALYZER_OBJC_INCOMP_METHOD_TYPES = YES
CLANG_ANALYZER_OBJC_COLLECTIONS = YES
CLANG_ANALYZER_OBJC_GENERICS = YES
CLANG_ANALYZER_OBJC_UNUSED_IVARS = YES
CLANG_ANALYZER_OBJC_SELF_INIT = YES
CLANG_ANALYZER_OBJC_RETAIN_COUNT = YES
CLANG_ANALYZER_SECURITY_FLOATLOOPCOUNTER = YES
CLANG_ANALYZER_SECURITY_KEYCHAIN_API = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_UNCHECKEDRETURN = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_GETPW_GETS = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_MKSTEMP = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_RAND = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_STRCPY = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_VFORK = YES

// "Gatherers"
WW2_WARNINGS_Development    = $(WW2_WARNINGS_01)
WW2_WARNINGS_Debug          = $(WW2_WARNINGS_01)
WW2_WARNINGS_Release        =
WW2_WARNINGS_GM             =

// Actual build setting that Xcode cares about!
WARNING_CFLAGS = $(WW2_WARNINGS_$(CONFIGURATION))
