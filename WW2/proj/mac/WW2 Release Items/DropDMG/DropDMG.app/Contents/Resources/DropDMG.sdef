<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="DropDMG Terminology">
    <!-- #mark Standard Suite -->
    <suite name="Standard Suite" code="core" description="Common classes and commands for all applications.">
        <cocoa name="NSCoreSuite"/>
        <value-type name="missing value" code="msng">
          <cocoa class="NSNull"/>
        </value-type>
        <!-- #mark Standard Suite / application -->
        <class name="application" code="capp" description="The application&apos;s top-level scripting object.">
            <cocoa class="NSApplication"/>
            <element type="window" access="r">
                <cocoa key="orderedWindows"/>
            </element>
            <property name="name" code="pnam" description="The name of the application." type="text" access="r"/>
            <property name="frontmost" code="pisf" description="Is this the frontmost (active) application?" type="boolean" access="r">
                <cocoa key="isActive"/>
            </property>
            <property name="version" code="vers" description="The version of the application." type="text" access="r"/>
            <responds-to command="open">
                <cocoa method="handleOpenScriptCommand:"/>
            </responds-to>
            <responds-to command="print">
                <cocoa method="handlePrintScriptCommand:"/>
            </responds-to>
            <responds-to command="quit">
                <cocoa method="handleQuitScriptCommand:"/>
            </responds-to>
        </class>
    	<!-- #mark Standard Suite / window -->
        <class name="window" code="cwin" description="A window.">
            <cocoa class="NSWindow"/>
            <property name="name" code="pnam" description="The full title of the window." type="text" access="r">
                <cocoa key="title"/>
            </property>
            <property name="id" code="ID  " description="The unique identifier of the window." type="integer" access="r">
                <cocoa key="uniqueID"/>
            </property>
            <property name="index" code="pidx" description="The index of the window, ordered front to back." type="integer">
                <cocoa key="orderedIndex"/>
            </property>
            <property name="bounds" code="pbnd" description="The bounding rectangle of the window." type="rectangle">
                <cocoa key="boundsAsQDRect"/>
            </property>
            <property name="closeable" code="hclb" description="Whether the window has a close box." type="boolean" access="r">
                <cocoa key="hasCloseBox"/>
            </property>
            <property name="minimizable" code="ismn" description="Whether the window can be minimized." type="boolean" access="r">
                <cocoa key="isMiniaturizable"/>
                <synonym name="miniaturizable"/>
            </property>
            <property name="minimized" code="pmnd" description="Whether the window is currently minimized." type="boolean">
                <cocoa key="isMiniaturized"/>
                <synonym name="miniaturized"/>
            </property>
            <property name="resizable" code="prsz" description="Whether the window can be resized." type="boolean" access="r">
                <cocoa key="isResizable"/>
            </property>
            <property name="visible" code="pvis" description="Whether the window is currently visible." type="boolean">
                <cocoa key="isVisible"/>
            </property>
            <property name="zoomable" code="iszm" description="Whether the window can be zoomed." type="boolean" access="r">
                <cocoa key="isZoomable"/>
            </property>
            <property name="zoomed" code="pzum" description="Whether the window is currently zoomed." type="boolean">
                <cocoa key="isZoomed"/>
            </property>
        </class>
       	<!-- #mark Standard Suite / Commands -->
        <command name="quit" code="aevtquit" description="Quit the application.">
            <cocoa class="NSQuitCommand"/>
        </command>
        <command name="count" code="corecnte" description="Return the number of elements of a particular class within an object.">
            <cocoa class="NSCountCommand"/>
            <direct-parameter description="the object whose elements are to be counted" type="specifier"/>
            <parameter name="each" code="kocl" description="The class of objects to be counted." type="type" optional="yes">
                <cocoa key="ObjectClass"/>
            </parameter>
            <result description="the number of elements" type="integer"/>
        </command>
        <command name="delete" code="coredelo" description="Delete an object.">
            <cocoa class="NSDeleteCommand"/>
            <direct-parameter description="the object to delete" type="specifier"/>
        </command>
        <command name="duplicate" code="coreclon" description="Copy object(s) and put the copies at a new location.">
            <cocoa class="NSCloneCommand"/>
            <direct-parameter description="the object(s) to duplicate" type="specifier"/>
            <parameter name="to" code="insh" description="The location for the new object(s)." type="location specifier" optional="yes">
                <cocoa key="ToLocation"/>
            </parameter>
            <parameter name="with properties" code="prdt" description="Properties to be set in the new duplicated object(s)." type="record" optional="yes">
                <cocoa key="WithProperties"/>
            </parameter>
            <result description="to the duplicated object(s)" type="specifier"/>
        </command>
        <command name="exists" code="coredoex" description="Verify if an object exists.">
            <cocoa class="NSExistsCommand"/>
            <direct-parameter description="the object in question" type="any"/>
            <result description="true if it exists, false if not" type="boolean"/>
        </command>
        <command name="make" code="corecrel" description="Make a new object.">
            <cocoa class="NSCreateCommand"/>
            <parameter name="new" code="kocl" description="The class of the new object." type="type">
                <cocoa key="ObjectClass"/>
            </parameter>
            <parameter name="at" code="insh" description="The location at which to insert the object." type="location specifier" optional="yes">
                <cocoa key="Location"/>
            </parameter>
            <parameter name="with contents" code="data" description="The initial contents of the object." type="any" optional="yes">
                <cocoa key="ObjectData"/>
            </parameter>
            <parameter name="with properties" code="prdt" description="The initial values for properties of the object." type="record" optional="yes">
                <cocoa key="KeyDictionary"/>
            </parameter>
            <result description="to the new object" type="specifier"/>
        </command>
        <command name="move" code="coremove" description="Move object(s) to a new location.">
            <cocoa class="NSMoveCommand"/>
            <direct-parameter description="the object(s) to move" type="specifier"/>
            <parameter name="to" code="insh" description="The new location for the object(s)." type="location specifier">
                <cocoa key="ToLocation"/>
            </parameter>
            <result description="to the moved object(s)" type="specifier"/>
        </command>
    </suite>
    <!-- #mark DropDMG Suite -->
    <suite name="DropDMG Suite" code="DDMG">
       	<!-- #mark DropDMG Suite / Enumerations -->
        <enumeration name="format" code="dmgF">
            <enumerator name="zlib compressed" code="ZLib" description=".dmg — smaller file, faster"/>
            <enumerator name="LZFSE compressed" code="LZFs" description=".dmg — smaller file, fastest"/>
            <enumerator name="bzip2 compressed" code="Bzp2" description=".dmg — smallest file, slower"/>
            <enumerator name="read only" code="Read" description=".dmg — no compression"/>
            
            <enumerator name="sparse bundle" code="SprB" description=".sparsebundle — most efficient"/>
            <enumerator name="sparse image" code="Sprs" description=".sparseimage — more efficient"/>
            <enumerator name="read write" code="Writ" description=".dmg — constant file size"/>

            <enumerator name="tar gz archive" code="TarG" description=".tar.gz — smaller file, faster"/>
            <enumerator name="tar bz2 archive" code="TarB" description=".tar.bz2 — smallest file, slower"/>
            <enumerator name="tar archive" code="TarA" description=".tar — no compression"/>
            <enumerator name="zip archive" code="ZipA" description=".zip — smaller file, faster"/> 
            
            <enumerator name="hybrid" code="Hybr" description=".iso Hybrid (HFS+, ISO, Joliet, UDF)"/>
            <enumerator name="master" code="Mast" description=".cdr DVD/CD-R master"/>
            
            <enumerator name="NDIF compressed" code="NDIF" description=".img compressed"/>
            <enumerator name="NDIF read only" code="NDro" description=".img read-only"/>
            <enumerator name="NDIF read write" code="NDrw" description=".img read-write"/>
        </enumeration>
        <enumeration name="encryption" code="dmEn">
            <enumerator name="AES 128" code="A128" description="Faster, works on Mac OS X 10.4."/>
            <enumerator name="AES 256" code="A256" description="More secure, requires Mac OS X 10.5 or later."/>
            <enumerator name="unencrypted" code="Unen" description="Fastest."/>
        </enumeration>
       	<!-- #mark DropDMG Suite / Commands -->
        <command name="burn" code="DDMGBurn" description="Burn a disk image, file, or folder to CD or DVD.">
            <parameter name="disk image" code="Imag" type="file" optional="yes" description="Burn the contents of the disk image.">
                <cocoa key="diskImage"/>
            </parameter>
            <parameter name="file or folder" code="File" type="file" optional="yes" description="Burn the file or folder.">
                <cocoa key="fileOrFolder"/>
            </parameter>
        </command>
        <command name="create" code="DDMGCrIm" description="Create a disk image or archive and return the new file.">
            <parameter name="from" code="Path" type="file" description="A source file or folder. If you specify a disk image, DropDMG will convert it.">
                <cocoa key="from"/>
            </parameter>
            <parameter name="configuration name" code="ConN" type="text" optional="yes" description="The name of a collection of DropDMG settings. If this parameter is specified, it overrides the other parameters. If &quot;&quot; is specified, uses the current configuration chosen in the preferences.">
                <cocoa key="configurationName"/>
            </parameter>
            <parameter name="always create" code="bACr" type="boolean" optional="yes" description="Always create a new image or archive, rather than trying to convert the existing source image/archive.">
                <cocoa key="alwaysCreate"/>
            </parameter>
            <parameter name="format" code="Form" type="format" optional="yes" description="(defaults to zlib compressed)">
                <cocoa key="format"/>
            </parameter>
            <parameter name="encryption" code="eEnc" type="encryption" optional="yes" description="(defaults to unencrypted)">
                <cocoa key="encryption"/>
            </parameter>
            <parameter name="passphrase" code="Pass" type="text" optional="yes" description="The passphrase for an encrypted image. Prompts if unspecified.">
                <cocoa key="passphrase"/>
            </parameter>
            <parameter name="segment size" code="SegS" type="integer" optional="yes" description="In megabytes. 0 means don't segment. (defaults to 0)">
                <cocoa key="segmentSize"/>
            </parameter>
            <parameter name="layout name" code="LayN" type="text" optional="yes" description="&quot;&quot; means no layout agreement. (defaults to &quot;&quot;)">
                <cocoa key="layoutName"/>
            </parameter>
            <parameter name="layout folder" code="LayF" type="file" optional="yes" description="This can be used to pass in a layout that’s stored outside of DropDMG, e.g. under version control.">
                <cocoa key="layoutFolder"/>
            </parameter>
            <parameter name="APP_BASENAME" code="svBN" type="text" optional="yes" description="The value for the ${APP_BASENAME} variable in the layout.">
                <cocoa key="appBasename"/>
            </parameter>
            <parameter name="APP_SHORT_VERSION_STRING" code="svVS" type="text" optional="yes" description="The value for the ${APP_SHORT_VERSION_STRING} variable in the layout.">
                <cocoa key="appShortVersionString"/>
            </parameter>
            <parameter name="APP_VERSION" code="svVN" type="text" optional="yes" description="The value for the ${APP_VERSION} variable in the layout.">
                <cocoa key="appVersion"/>
            </parameter>
            <parameter name="license name" code="AgrN" type="text" optional="yes" description="&quot;&quot; means no license agreement. (defaults to &quot;&quot;)">
                <cocoa key="licenseName"/>
            </parameter>
            <parameter name="license folder" code="AgrF" type="file" optional="yes" description="This can be used to pass in a license that’s stored outside of DropDMG, e.g. under version control.">
                <cocoa key="licenseFolder"/>
            </parameter>
            <parameter name="custom icon" code="Icon" type="boolean" optional="yes" description="Customize the icon of the mounted image.">
                <cocoa key="customIcon"/>
            </parameter>
            <parameter name="internet enabled" code="bNet" type="boolean" optional="yes" description="(defaults to false)">
                <cocoa key="internetEnabled"/>
            </parameter>
            <parameter name="optimizing for restores" code="bASR" type="boolean" optional="yes" description="(defaults to false)">
                <cocoa key="optimizeForRestores"/>
            </parameter>
            <parameter name="append current date" code="bDat" type="boolean" optional="yes" description="Append the current date to the name of the output file? (defaults to false)">
                <cocoa key="appendCurrentDate"/>
            </parameter>
            <parameter name="append version number" code="bVer" type="boolean" optional="yes" description="Append the version number of the application being imaged to the name of the output file? (defaults to false)">
                <cocoa key="appendVersionNumber"/>
            </parameter>
            <parameter name="sanitize for servers" code="bSrv" type="boolean" optional="yes" description="Replace spaces and non-ASCII characters in the file name? (defaults to false)">
                <cocoa key="sanitizeForServers"/>
            </parameter>
            <parameter name="base name" code="Base" type="text" optional="yes" description="&quot;&quot; means automatic. (defaults to &quot;&quot;)">
                <cocoa key="basename"/>
            </parameter>
            <parameter name="volume name" code="VolN" type="text" optional="yes" description="&quot;&quot; means automatic. (defaults to &quot;&quot;)">
                <cocoa key="volumeName"/>
            </parameter>
            <parameter name="destination" code="Dest" type="file" optional="yes" description="A folder. If absent, the destination is next to the source.">
                <cocoa key="destination"/>
            </parameter>
            <parameter name="delete original" code="bDel" type="boolean" optional="yes" description="(defaults to false)">
                <cocoa key="deleteOriginal"/>
            </parameter>
            <result type="file"/>
        </command>
        <command name="mount" code="DDMGMont" description="Mount a disk image file.">
            <parameter name="disk image" code="Imag" type="file" optional="yes" description="The disk image file.">
                <cocoa key="diskImage"/>
            </parameter>
            <parameter name="configuration name" code="ConN" type="text" optional="yes" description="The name of the configuration holding the passphrase for an encrypted disk image.">
                <cocoa key="configurationName"/>
            </parameter>
            <parameter name="passphrase" code="Pass" type="text" optional="yes" description="The passphrase for an encrypted image. You do not have to specify this if you already specified the configuration name. If the passphrase is not specified, you will be prompted to enter it.">
                <cocoa key="passphrase"/>
            </parameter>
            <parameter name="verification" code="bVer" type="boolean" optional="yes" description="Should the disk image be verified before mounting? (defaults to yes)">
                <cocoa key="verification"/>
            </parameter>
            <parameter name="file ownership" code="bOwn" type="boolean" optional="yes" description="Should files on the mounted disk image have their correct owners? (defaults to yes)">
                <cocoa key="fileOwnership"/>
            </parameter>
            <parameter name="shadow file" code="bShw" type="boolean" optional="yes" description="Should changes to the mounted disk image be saved to a shadow file? (defaults to no)">
                <cocoa key="shadowFile"/>
            </parameter>
            <parameter name="mount location" code="FLoc" type="file" optional="yes" description="A folder where the disk image should be mounted instead of on the desktop.">
                <cocoa key="mountLocation"/>
            </parameter>
            <result type="file"/>
        </command>
       	<!-- #mark DropDMG Suite / Classes -->
        <class name="application" inherits="application" code="capp">
            <cocoa class="NSApplication"/>
            <property name="background activity count" code="bthc" type="integer" access="r" description="Number of background activities currently running in DropDMG, according to the Activity window.">
                <cocoa key="scriptingBackgroundActivityCount"/>
            </property>
            <element description="" type="configuration" access="r">
                <cocoa key="scriptingConfigurations"/>
                <accessor style="id"/>
            </element>
            <responds-to command="burn">
                <cocoa method="handleBurnScriptCommand:"/>
            </responds-to>
            <responds-to command="create">
                <cocoa method="handleCreateScriptCommand:"/>
            </responds-to>
            <responds-to command="mount">
                <cocoa method="handleMountScriptCommand:"/>
            </responds-to>
        </class>
        <class name="configuration" code="Conf" description="" plural="configurations">
            <cocoa class="ConfigFile"/>
            <property name="name" code="pnam" type="text" access="r">
                <cocoa key="displayName"/>
            </property>
            <property name="id" code="ID  " type="text" access="r">
                <cocoa key="identifier"/>
            </property>
            <property name="format" code="Form" type="format" access="r">
                <cocoa key="scriptingFormat"/>
            </property>
        </class>
    </suite>
    <!-- #mark Internet Suite -->
    <suite name="Internet Suite" code="gurl">
        <command name="get url" code="GURLGURL" description="Open a x-dropdmg:// URL">
            <cocoa class="MJTURLHandlerCommand"/>
            <direct-parameter description="the URL to open" type="text"/>
        </command>
    </suite>
</dictionary>