    CTEXT           "Select a video mode for your display.\nThe modes available for your system are listed below.",IDC_STATIC,7,7,214,30
    DEFPUSHBUTTON   "OK",IDOK,56,73,50,15
    PUSHBUTTON      "Cancel",IDCANCEL,122,73,50,15
END


