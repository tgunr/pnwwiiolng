    DEFPUSHBUTTON   "OK",IDOK,93,41,50,15
END

IDD_MESSAGES DIALOG 0, 0, 256, 63
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP
FONT 8, "MS Sans Serif"
BEGIN
