IDD_VIDEO_DEVICE DIALOG 0, 0, 229, 63
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Video Device Error"
FONT 8, "MS Sans Serif"
BEGIN
    CTEXT           "Unable to find specified video device. Please run configuration utility.",IDC_STATIC,18,7,195,30
    DEFPUSHBUTTON   "OK",IDOK,93,41,50,15
END

IDD_PROPERTYSHEET DIALOG 0, 0, 200, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Propertysheet"
FONT 8, "MS Sans Serif"
BEGIN
