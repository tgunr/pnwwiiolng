<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup
    Condition="'$(OMGGenBeforeTargets)' == '' and '$(OMGGenAfterTargets)' == '' and '$(ConfigurationType)' != 'Makefile'">
    <OMGGenBeforeTargets>Midl</OMGGenBeforeTargets>
    <OMGGenAfterTargets>CustomBuild</OMGGenAfterTargets>
  </PropertyGroup>
  <PropertyGroup>
    <OMGGenDependsOn
      Condition="'$(ConfigurationType)' != 'Makefile'">_SelectedFiles;$(OMGGenDependsOn)</OMGGenDependsOn>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <OMGGen>
      <CommandLineTemplate>$(BinOutDir)omggen.exe -D%(RelativeDir) --cxx=%(Filename).cxx --hxx=%(Filename).hxx %(Filename).omg</CommandLineTemplate>
      <Outputs>%(RelativeDir)%(Filename).cxx;%(RelativeDir)%(Filename).hxx</Outputs>
      <ExecutionDescription>Processing .omg files</ExecutionDescription>
      <AdditionalDependencies>$(BinOutDir)omggen.exe;%(RelativeDir)typedefs.omg</AdditionalDependencies>
    </OMGGen>
  </ItemDefinitionGroup>
</Project>
