//
// Version
//

#include "..\versionNo.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION PN_WW2_VERSION_NO,PN_WW2_PATCH_NO,PN_WW2_BUILD_NO,0
 PRODUCTVERSION PRODUCTVER
 FILEFLAGSMASK VS_FF_DEBUG | VS_FF_PRERELEASE
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Massively Multiplayer Online Game\0"
            VALUE "CompanyName", "Playnet, Inc.\0"
            VALUE "FileDescription", "WW2\0"
			VALUE "FileVersion", STRVER "\0"
            VALUE "InternalName", "WW2\0"
            VALUE "LegalCopyright", "Copyright © 2000-2011\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "WW2.exe\0"
            VALUE "PrivateBuild", "\0"
            VALUE "ProductName", "Playnet, Inc. WW2\0"
            VALUE "ProductVersion", STRPRODUCTVER "\0"
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#endif    // !_MAC

