/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 285, 206
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Language",IDC_STATIC_LANGUAGE,19,10,83,10
    COMBOBOX        IDC_COMBO_LANGUAGES,19,22,83,64,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Connection",IDC_STATIC_NETWORK,114,10,150,10
    COMBOBOX        IDC_COMBO_NETWORK,114,22,150,49,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Video Card",IDC_STATIC_VIDEO_CARD,19,53,245,10
    COMBOBOX        IDC_COMBO_VIDEO_CARD,19,65,245,62,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Resolution",IDC_STATIC_RESOLUTION,19,84,245,10
    COMBOBOX        IDC_COMBO_RESOLUTION,19,96,245,62,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sound Card",IDC_STATIC_SOUND_CARD,17,137,247,10
    COMBOBOX        IDC_COMBO_SOUND_CARD,17,149,247,49,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Save",IDOK,18,180,60,16
    PUSHBUTTON      "Cancel",IDCANCEL,204,180,62,16
    GROUPBOX        "Video",IDC_STATIC_VIDEO,12,42,264,79
    GROUPBOX        "Sound",IDC_STATIC_SOUND,12,126,264,46
END


