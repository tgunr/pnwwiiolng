//
// Dialog
//

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 232, 231
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    COMBOBOX        IDC_COMBO_LANGUAGES,13,20,65,64,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_NETWORK,90,20,135,49,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_VIDEO_CARD,25,70,182,62,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_RESOLUTION,25,100,84,62,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Video Card",IDC_STATIC_VIDEO_CARD,27,60,74,8
    GROUPBOX        "Video",IDC_STATIC_VIDEO,15,45,210,79
    LTEXT           "Resolution",IDC_STATIC_RESOLUTION,28,90,85,8
