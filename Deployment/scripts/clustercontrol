#!/bin/bash 

#############
# Game Cluster Control Application.
#############

if [[ $( whoami ) != "wwiiol" ]]; then
	echo "clustercontrol must be run as the wwiiol user to prevent permissions issues"
	exit 1
fi

CLUSTER_DOWN=${CLUSTER_DOWN:-/tmp/CLUSTER_DOWN}

case "$1" in
  start)
	# Make sure log save directory exists
	mkdir -p /home/wwiiol/logs || { echo "can't ensure log directory"; exit 1 ; }
	[[ -w /home/wwiiol/logs ]] || { echo "log directory isn't writeable"; exit 1 ; }

	# Mark cluster online so periodic scripts will try to restart i
	rm -f $CLUSTER_DOWN

	# Be in the right place so the binaries find their config file
	cd /playnet/wwiiol/bin

	# check which application needs to be started and start it
	if [ "$2" = "stratd" ]; then
		/playnet/wwiiol/bin/dbd >/dev/null 2>&1 &
		sleep 2
		/playnet/wwiiol/bin/stratd >/dev/null 2>&1 &
		echo started dbd and stratd
	elif [ "$2" = "chatd" ]; then
		/playnet/wwiiol/bin/chatd >/dev/null 2>&1 &
		echo started chatd
	elif [ "$2" = "cellhost" ]; then
		/playnet/wwiiol/bin/hostd >/dev/null 2>&1 &
		echo started hostd -db
	elif [ "$2" = "mmhostd" ]; then
		/playnet/wwiiol/bin/mmhostd >/dev/null 2>&1 &
		echo started mmhostd
	else
		echo "Unknown host $2!"
		exit 1
	fi
	exit 0
	;;

  stop)
	# Mark cluster down
	touch $CLUSTER_DOWN
	
	# Try a gentler SIGINT first, then forcibly SIGKILL anything that stuck around
	possible_processes="mmhostd hostd chatd stratd dbd stratd_all_firebases chatUpdater teuld pinghostd"
	killall -q -v -s INT $possible_processes
	sleep 2
	killall -q -v -s KILL $possible_processes

	# Save logs
	/playnet/bin/savelogs || { echo "WARNING: FAILED TO SAVE LOG FILES!"; exit 1 ; }
	;;
  *)
	# Help message
	echo "Usage: $0 start {stratd|chatd|cellhost|mmhostd}"
	echo "       $0 stop"
	echo
	echo "Example: $0 start stratd"
esac

exit 0

