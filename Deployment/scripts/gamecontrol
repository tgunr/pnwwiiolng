#!/usr/bin/env php
<?php

// 8/5/2017 - frisbone - Modified, allow nodecontrol to control timing
//
// NOTES:
//         1. Pull out list of servers so the code is independent of what is being controlled

$version = '0.2.2';

include '/playnet/bin/gamecontrolvars.php';
//
// Above PHP file should contain the definition of all controllable clusters:
//
// Example of entries below:
//
// $clusters = [
//    2 => [
//        'clusterid' => 2, 'names' => ['Cluster1', 'Dev'], 'arenaid' => 250,
//        'version' => '1.35.8.1', 'description' => "Open Beta", 'visibility' => 'visible',
//        'hosts' => [
//            1 => [ 'hostname' => 'cluster1-1', 'command' => 'strat' ], 2 => [ 'hostname' => 'cluster1-2', 'command' => 'chat' ],
//            3 => [ 'hostname' => 'cluster1-3', 'command' => 'map' ],
//        ],
//        'cells' => [
//            1 => [ 'hostname' => 'cluster1-4', 'activate' => true ],
//        ],
//   ];
//
function do_help($msg) {
    global $version, $clusters, $argv;
    
    if (!is_null($msg)) {
        print "{$msg}\n\n";
    }
    print "gamecontrol version {$version}\n";
    print "Usage: {$argv[0]} {start|stop|stby|restart|savelogs} {cluster|cell} {name|ID} [cell Num]\n";
    print "\n";
    print "Cluster is one of:\n";
    foreach ($clusters as $cluster) {
	if (isset($cluster['name'])) {
		$name = $cluster['name'];
	} else {
		$name = implode("/", $cluster['names']);
	}
        print "\t{$name}: ID ${cluster['clusterid']}, arena {$cluster['arenaid']} - {$cluster['description']}\n";
    }
    print "\n";
    print "Examples:\n";
    print "\tgamecontrol start cluster Dev1\n";
    print "\tgamecontrol stop cluster Dev2\n";
    print "\tgamecontrol stop cell Dev2 3\n";
    print "\tgamecontrol stby cell Dev2 4\n";
    print "\tgamecontrol start cell Dev2 1\n";
    exit(0);
}

function commandForHost($host, $action, $needTerm) {
    $cmds = [ '-l', 'wwiiol',
                '-i', '/root/.ssh/id_rsa.master',
                "{$host['hostname']}.playnet.com",
                $action
           ];
    if ($needTerm) {
        array_unshift($cmds, '-t');
    } 
    return escapeshellcmd('ssh') . ' ' .  implode(' ', array_map('escapeshellarg', $cmds));
}

function controlCommandForHost($host, $action, $cmd = "") {
	if (empty($cmd)) {	
    	$processmap = [ 'strat' => 'stratd', 'chat' => 'chatd', 'map' => 'mmhostd'];
		$cmd = $processmap[$host['command']];
	}
    return "/playnet/bin/nodecontrol {$action} {$cmd}";
}

function runCommand($cmd) {
    print "EXECUTING: {$cmd}\n";
    passthru($cmd, $exitValue);
    if ($exitValue != 0) {
        print "WARNING: Execution failure. Continue? [yN] ";
        $response = fgets(STDIN);
        if (is_null($response) || ($response[0] !== 'y' && $response[0] !== 'Y')) {
            exit($exitValue);
        }
    }
}

function startCluster($cluster) {

    foreach ($cluster['hosts'] as $n => $host) {
		if ($host['command'] === 'map') {
			// start all activated cells
			startCell($cluster, 0);
		}
        runCommand(commandForHost($host, controlCommandForHost($host, 'start'), true));
    }
}

function startCell($cluster, $cellnum) {

    foreach ($cluster['cells'] as $n => $cellhost) {
		if ($cellnum == 0 || $n == $cellnum) {
			if ($cellhost['activate']) {
				runCommand(commandForHost($cellhost, controlCommandForHost($cellhost, 'start', 'cellhost'), true)); 
			} else {
    			print "Not starting deactivated cell #{$n}, tagging as standby : {$cellhost['hostname']}\n";
        	    runCommand(commandForHost($cellhost, controlCommandForHost($cellhost, 'stby', 'cellhost'), false));
			}	
		}
	}
}

function stopCluster($cluster) {
    foreach ($cluster['hosts'] as $n => $host) {
		if ($host['command'] === 'map') {
			// stop all cells
			stopCell($cluster, 0);
		}
        runCommand(commandForHost($host, controlCommandForHost($host, 'stop'), false));
    }
}

function stopCell($cluster, $cellnum) {
    foreach ($cluster['cells'] as $n => $cellhost) {
		if ($cellnum == 0 || $n == $cellnum) {
        	  runCommand(commandForHost($cellhost, controlCommandForHost($cellhost, 'stop', 'cellhost'), false));
		}
	}
}

function stbyCell($cluster, $cellnum) {
    foreach ($cluster['cells'] as $n => $cellhost) {
		if ($n == $cellnum) {
        	  runCommand(commandForHost($cellhost, controlCommandForHost($cellhost, 'stby', 'cellhost'), false));
		}
	}
}

function restartCluster($cluster) {
    stopCluster($cluster);
    print "Waiting 5 seconds before starting cluster up again.\n";
    sleep(5);
    startCluster($cluster);
}

function restartCell($cluster, $cellnum) {
    stopCell($cluster, $cellnum);
    print "Waiting 5 seconds before starting cluster up again.\n";
    sleep(5);
    startCell($cluster, $cellnum);
}

function savelogsCluster($cluster) {
    foreach ($cluster['hosts'] as $n => $host) {
        runCommand(commandForHost($host, '/playnet/bin/savelogs'));
    }
}

if (in_array('--help', $argv)) {
    do_help(NULL);
}

if ($argc < 4) {
    do_help("Not enough arguments");
}

$type = $argv[2];
if ($type !== 'cluster' && $type !== 'cell') {
    do_help("Only cluster control is currently supported");
}

if ($type == 'cluster' && !in_array($cmd = $argv[1], ['start', 'stop', 'restart', 'savelogs'])) {
    do_help("Unknown operation {$cmd}");
}

if ($type == 'cell' && !in_array($cmd = $argv[1], ['start', 'stop', 'stby', 'restart', 'savelogs'])) {
    do_help("Unknown operation {$cmd}");
}

$which = $argv[3];
if (ctype_digit($which)) {
    if (!isset($clusters[intval($which)])) {
        do_help("Unknown cluster ID {$which}");
    }
    $cluster = $clusters[intval($which)];
} else {
    foreach ($clusters as $maybeCluster) {
		if (isset($maybeCluster['name']) && strtolower($maybeCluster['name']) === strtolower($which)) {
            $cluster = $maybeCluster;
        } else if (isset($maybeCluster['names'])) {
			foreach ($maybeCluster['names'] as $name) {
				if (strtolower($name) == strtolower($which)) {
					$cluster = $maybeCluster;
					break;
				}
			}
		}
    }
    if (!isset($cluster)) {
        do_help("Unknown cluster name {$which}");
    }
}

if ($type === 'cell') {
   $cellnum = $argv[4];
}

print "Operating on {$which} (ID {$cluster['clusterid']}, arena ID {$cluster['arenaid']})\n";
if ($type === 'cell') {
	if ($cmd === 'start') {
    	startCell($cluster, $cellnum);
	} else if ($cmd === 'stop') {
    	stopCell($cluster, $cellnum);
	} else if ($cmd === 'stby') {
    	stbyCell($cluster, $cellnum);
	} else if ($cmd === 'restart') {
    	restartCell($cluster, $cellnum);
	} else {
		print "Bad command- this shouldn't happen.\n";
		exit(128);
	}
} else {
	if ($cmd === 'start') {
    	startCluster($cluster);
	} else if ($cmd === 'stop') {
    	stopCluster($cluster);
	} else if ($cmd === 'restart') {
    	restartCluster($cluster);
	} else if ($cmd === 'savelogs') {
    	savelogsCluster($cluster);
	} else {
		print "Bad command- this shouldn't happen.\n";
		exit(128);
	}
}

?>
